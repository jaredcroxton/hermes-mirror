# AI Phone Receptionist - credentials template
# No real values in this file. Copy to .env and fill in during the Link phase.

# Telephony (Twilio) - rent one AU local number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_AU_NUMBER=            # +61 x xxxx xxxx, the AI number the divert points to

# Voice platform (ElevenLabs Agents - voice, STT and LLM bundled)
ELEVENLABS_API_KEY=         # ElevenLabs account API key
ELEVENLABS_AGENT_ID=        # the agent you create in the dashboard
ELEVENLABS_VOICE_ID=        # chosen AU-accent voice from the library

# Optional custom brain (ElevenLabs uses its own LLM by default; set only to bring your own)
OPENAI_API_KEY=             # optional - GPT-4o-mini
ANTHROPIC_API_KEY=          # optional - Claude Haiku

# Booking calendar - pick ONE
CALCOM_API_KEY=             # cal.com free tier
CALCOM_EVENT_TYPE_ID=
GOOGLE_CALENDAR_ID=         # or the business Google Calendar

# Post-call delivery
MAKE_WEBHOOK_URL=           # or ZAPIER_WEBHOOK_URL
OWNER_EMAIL=                # where transcripts + summaries land
OWNER_SMS_NUMBER=           # owner mobile for urgent escalations
